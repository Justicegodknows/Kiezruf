DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=kiezruf
S3_SECRET_KEY=kiezruf-dev-secret
S3_BUCKET_PRIVATE=photos-private
S3_BUCKET_PUBLIC=photos-public
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Kiezruf <no-reply@kiezruf.localhost>
# Public URL of the bucket with blurred photos.
PUBLIC_PHOTO_BASE_URL=http://localhost:9000/photos-public
# Proxies whose X-Forwarded-For the API trusts (the citizen web server), comma-separated IPs or CIDRs.
TRUST_PROXY=127.0.0.1,::1
# Citizen web, for links in notification emails (worker).
WEB_BASE_URL=http://localhost:3000
# Supabase (ENG-22): sign-in and the database. Locally `supabase start` prints these values.
# DATABASE_URL above must point at the Supabase database (direct connection or session pooler, port 5432).
SUPABASE_URL=http://127.0.0.1:54321
# Only for HS256 projects (the local Supabase stack signs with HS256); hosted projects use JWKS keys.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_SERVICE_ROLE_KEY=
# EU AI provider (D-13, D-15), OpenAI-compatible. Endpoint and models to be agreed with vlincta.com (E-01).
# Empty: no AI (no category suggestions, duplicates by distance only, fallback briefings).
# Model names are optional: left empty, requests carry no `model` and the provider picks one.
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_MODEL_CHAT=
AI_MODEL_VISION=
AI_MODEL_EMBEDDING=
# Blur until vlincta's blur endpoint is known: "full" blurs whole photos (development), "none" keeps them unpublished.
BLUR_DETECTOR=full
