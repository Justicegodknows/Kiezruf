# apps/web (citizen web and console). Copy to .env.local for `pnpm --filter web dev`; on Vercel set these in the
# project's Environment Variables (Production, Preview, Development). Read at request time, so `next build`
# needs none of them.

# Supabase Auth (ENG-22). Locally `supabase start` prints both values (API URL and the anon / publishable key).
# Hosted: Project Settings → API. The publishable key is safe to expose; the service-role key never goes here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The Kiezruf API (apps/api), reached server-side by the backend-for-frontend routes under /api.
API_BASE_URL=http://localhost:4000
