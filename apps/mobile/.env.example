# Citizen app configuration. Copy to .env.local (git-ignored) and fill in.
# EXPO_PUBLIC_* values are inlined into the app bundle at build time: they are public, never put secrets here.

# Kiezruf API (apps/api). Default: http://localhost:4000
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# MapLibre style URL (ENG-13). Default: the public OpenFreeMap style (development only, see E-08).
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Supabase Auth (ENG-22): sign-in with a 6-digit email code. Supabase dashboard > Project Settings > API.
# The project URL (default: a local `supabase start` at http://localhost:54321) ...
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# ... and the publishable (anon) key. Never the service-role / secret key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
