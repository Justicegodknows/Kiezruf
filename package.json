{
  "name": "kiezruf",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:mobile": "pnpm --filter mobile start",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "typecheck": "pnpm -r typecheck",
    "prepare": "git config core.hooksPath .githooks || true",
    "progress:read": "node scripts/progress-gate.mjs read",
    "progress:check": "node scripts/progress-gate.mjs check",
    "test": "pnpm test:gate && pnpm -r --if-present test",
    "test:gate": "node --test \"scripts/*.test.mjs\"",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "test:int": "pnpm --filter api test:int",
    "test:features": "pnpm --filter api test:features && pnpm --filter web test:e2e",
    "test:mobile": "pnpm --filter mobile test",
    "test:maestro": "pnpm --filter mobile test:maestro",
    "audit": "pnpm audit --audit-level high"
  }
}
